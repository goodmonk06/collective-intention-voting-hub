# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://intention_user:intention_pass@localhost:5432/intention_hub"

# ============================================================
# REDIS (Optional - for caching and sessions)
# ============================================================
REDIS_URL="redis://localhost:6379"

# ============================================================
# AI PROVIDERS (Optional - for intention summarization)
# ============================================================
# OpenAI
OPENAI_API_KEY="your-openai-api-key-here"

# Anthropic Claude
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# ============================================================
# NOTIFICATION PROVIDERS (Optional)
# ============================================================
# Email
EMAIL_FROM="noreply@your-domain.com"
EMAIL_PROVIDER="sendgrid" # sendgrid | ses | postmark
SENDGRID_API_KEY="your-sendgrid-key"

# SMS
SMS_PROVIDER="twilio" # twilio | vonage
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+1234567890"

# ============================================================
# EXTERNAL AUTH (Optional)
# ============================================================
# OAuth providers
AUTH0_DOMAIN="your-domain.auth0.com"
AUTH0_CLIENT_ID="your-client-id"
AUTH0_CLIENT_SECRET="your-client-secret"

# ============================================================
# APPLICATION
# ============================================================
NODE_ENV="development" # development | production | test
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging
LOG_LEVEL="info" # debug | info | warn | error
LOG_METRICS="false" # Set to "true" to log metrics in development

# ============================================================
# WEBHOOKS (Optional)
# ============================================================
WEBHOOK_SECRET="your-webhook-signing-secret"

# ============================================================
# RATE LIMITING (Optional)
# ============================================================
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
